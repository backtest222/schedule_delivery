# Salin file ini menjadi ".env.local" lalu isi nilainya.
# JANGAN pernah mengunggah .env.local ke GitHub (sudah dikecualikan di .gitignore).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Kunci publik: "Publishable key". Aman tampil di browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Kunci rahasia: "Secret key". HANYA untuk server, dipakai untuk membuat akun pengguna.
SUPABASE_SECRET_KEY=

# Teks acak panjang (minimal 32 karakter) untuk mengamankan cadangan mingguan otomatis.
CRON_SECRET=

# Pengingat email H-3 (lihat PANDUAN.md bagian Pengingat email).
# Kunci API dari resend.com > API Keys. HANYA untuk server.
RESEND_API_KEY=
# Alamat pengirim; domainnya harus sudah diverifikasi di Resend.
EMAIL_FROM=Jadwal Pengiriman <notifikasi@domain-anda.com>
